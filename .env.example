# Private signing key — the SAME key pair the package's public key comes from.
# Local: point at the file. Production: paste the PEM into ACCOUNTING_LICENSE_PRIVATE_KEY
# (use \n for line breaks) and leave the path unset.
ACCOUNTING_LICENSE_PRIVATE_KEY_PATH=../account-backend/keys/private.pem
ACCOUNTING_LICENSE_PRIVATE_KEY=

# How long generated keys stay valid, and which plan they carry.
KEY_VALIDITY_DAYS=365
KEY_PLAN=standard

# Shown in the install instructions on the page.
NEXT_PUBLIC_PACKAGE_NAME=@virajadsul/accounting
